<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/menu_item_layout_bg"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/treatment_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:textColor="@color/dark_statusView"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="12:34" />

    <ImageView
        android:id="@+id/treatment_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@id/treatment_time"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_treatment" />

    <LinearLayout
        android:id="@+id/treatment_values"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@id/treatment_icon"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/treatment_bolus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/inrange"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="4.0 U" />

        <TextView
            android:id="@+id/treatment_carbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/carbs"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="50 g" />

    </LinearLayout>

    <TextView
        android:id="@+id/treatment_smb_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@color/carbs"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="SMB"
        android:textColor="@android:color/black"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

</RelativeLayout>
